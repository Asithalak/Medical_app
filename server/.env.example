# Server Port & Environment
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Details (Replace with your actual PostgreSQL credentials)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medilanka

# Optional Individual PostgreSQL connection variables (if not using DATABASE_URL):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=medilanka
# PGUSER=postgres
# PGPASSWORD=postgres
# PGSSL=false

# Security & CORS
JWT_SECRET=medilanka_secure_jwt_secret_key_2026_change_in_production
CORS_ORIGIN=http://localhost:8080

# Resend Email Service
RESEND_API_KEY=
RESEND_FROM_EMAIL=MediLanka Care <onboarding@resend.dev>

# Cloudinary Configuration for Medical Documents & Images
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

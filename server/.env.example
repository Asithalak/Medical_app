# Server Port & Environment
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Details (Replace with your actual PostgreSQL credentials)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medilanka

# Optional Individual PostgreSQL connection variables (if not using DATABASE_URL):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=medilanka
# PGUSER=postgres
# PGPASSWORD=postgres
# PGSSL=false

# Security & CORS
JWT_SECRET=medilanka_secure_jwt_secret_key_2026_change_in_production
CORS_ORIGIN=http://localhost:8080
